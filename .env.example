# --- Database ---
DATABASE_URL=postgresql://familyos:familyos@db:5432/familyos?schema=public

# --- Family access ---
# Set one or the other.
# Plain (hashed at runtime, never stored as plaintext in DB):
FAMILY_ACCESS_PASSWORD=changeme-pick-something-warm
# Or precomputed SHA-256 hex hash (if set, takes precedence):
# FAMILY_ACCESS_PASSWORD_HASH=

# Used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=please-generate-a-long-random-secret-here

# Session lifetime in days
SESSION_DAYS=30

# --- Google Calendar (placeholders, not wired in MVP) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# --- Optional AI suggestions (future) ---
OPENAI_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_NAME=FamilyOS
NEXT_PUBLIC_FAMILY_NAMES=Davide & Luize
NODE_ENV=development
PORT=3000
