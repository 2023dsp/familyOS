generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  low
  medium
  high
}

enum ChoreStatus {
  active
  completed
  archived
}

enum RecurrenceUnit {
  day
  week
  month
}

// ── Multi-tenant scaffolding ──────────────────────────────────
// Not enforced yet. Tables exist so the next phase can migrate the
// app from shared-family-password to email+password households.

enum HouseholdRole {
  owner
  admin
  member
  child
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  memberships  HouseholdMember[]
  ownedHouseholds Household[] @relation("HouseholdOwner")
}

model Household {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("HouseholdOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   HouseholdMember[]
  chores    Chore[]
  templates ChoreTemplate[]
  events    CalendarEvent[]
  categories Category[]
  familyMembers FamilyMember[]
  pushSubscriptions PushSubscription[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  userId      String
  householdId String
  role        HouseholdRole @default(member)
  displayName String?
  avatarSlug  String?       // maps to FamilyMember palette: davide | luize | …
  joinedAt    DateTime      @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
}

model HouseholdInvitation {
  id          String   @id @default(cuid())
  householdId String
  email       String
  role        HouseholdRole @default(member)
  token       String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([householdId])
}

// ── Legacy / current single-household models ──────────────────

model FamilyMember {
  id        String   @id @default(cuid())
  slug      String
  name      String
  initials  String
  color     String
  isPerson  Boolean  @default(true)
  isChild   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  chores         Chore[]         @relation("ChoreAssignee")
  assignedChores ChoreAssignee[]
  completions    ChoreCompletion[]

  @@unique([householdId, slug])
}

model ChoreAssignee {
  id        String   @id @default(cuid())
  choreId   String
  chore     Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  memberId  String
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([choreId, memberId])
  @@index([memberId])
}

model Category {
  id        String   @id @default(cuid())
  slug      String
  label     String
  icon      String
  color     String
  colorSoft String
  sortOrder Int      @default(0)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, slug])
}

model ChoreTemplate {
  id              String         @id @default(cuid())
  title           String
  icon            String
  category        String
  priority        Priority       @default(medium)
  defaultRecurInterval Int?
  defaultRecurUnit     RecurrenceUnit?
  seasonal        Boolean        @default(false)
  createdAt       DateTime       @default(now())

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Chore {
  id              String       @id @default(cuid())
  title           String
  notes           String?
  icon            String       @default("broom")
  category        String       @default("cleaning")
  priority        Priority     @default(medium)

  assigneeId      String?
  assignee        FamilyMember? @relation("ChoreAssignee", fields: [assigneeId], references: [id])

  dueDate         DateTime?
  isRecurring     Boolean      @default(false)
  recurInterval   Int?
  recurUnit       RecurrenceUnit?
  recurDaysOfWeek String?      // comma-sep e.g. "mon,fri" (weekly)
  recurDayOfMonth Int?         // monthly anchor day

  status          ChoreStatus  @default(active)
  important       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  completedAt     DateTime?

  googleEventId   String?      @unique
  googleSyncedAt  DateTime?

  reminderAt      DateTime?  // legacy single reminder (kept for back-compat)
  reminderSentAt  DateTime?

  householdId     String?
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  reminders       ChoreReminder[]
  assignees       ChoreAssignee[]

  completions     ChoreCompletion[]

  @@index([status, dueDate])
  @@index([householdId, status])
}

model ChoreReminder {
  id          String   @id @default(cuid())
  choreId     String
  chore       Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([scheduledAt, sentAt])
}

model ChoreCompletion {
  id          String       @id @default(cuid())
  choreId     String
  chore       Chore        @relation(fields: [choreId], references: [id], onDelete: Cascade)
  memberId    String?
  member      FamilyMember? @relation(fields: [memberId], references: [id])
  completedAt DateTime     @default(now())
  occurrenceFor DateTime?

  @@index([choreId, completedAt])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean  @default(false)
  calendar    String?
  color       String?
  persona     String?  // "davide" | "luize" | "family" | "other" | null
  source      String   @default("local") // local | google
  externalId  String?  @unique
  choreId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([startsAt])
  @@index([householdId])
}

model AppSetting {
  // Global settings keyed by string. Household-scoped settings will use a
  // namespaced key like "h_<householdId>_<key>" until a proper migration runs.
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  label      String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model PasswordReset {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}
